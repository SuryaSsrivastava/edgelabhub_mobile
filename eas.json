{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edgelabhub.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edgelabhub.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edgelabhub.com/api/v1"
      }
    },
    "live": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edgelabhub.com/api/v1",
        "LIVE_NOTIFICATION": "1",
        "EXPO_PUBLIC_LIVE_NOTIFICATION": "1"
      }
    },
    "development-live": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edgelabhub.com/api/v1",
        "LIVE_NOTIFICATION": "1",
        "EXPO_PUBLIC_LIVE_NOTIFICATION": "1"
      }
    },
    "release": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://edgelabhub.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
